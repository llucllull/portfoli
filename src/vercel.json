{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [{ "source": "/", "destination": "/es", "permanent": false }],
  "rewrites": [
    {
      "source": "/es/:path*",
      "destination": "/es/:path*/index.html"
    },
    {
      "source": "/ca/:path*",
      "destination": "/ca/:path*/index.html"
    },
    {
      "source": "/en/:path*",
      "destination": "/en/:path*/index.html"
    }
  ]
}
