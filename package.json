{
  "name": "portfoli",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng cache clean && ng serve portfoli --configuration development",
    "dev": "ng serve",
    "clean": "rimraf dist routes.txt",
    "prebuild": "npm run routes",
    "routes": "node src/app/scripts/prerender-routes.mjs",
    "sitemap": "node src/app/scripts/generate-sitemap.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:portfoli": "node dist/portfoli/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@cloudinary/ng": "^2.1.6",
    "@cloudinary/url-gen": "^1.22.0",
    "@lluc_llull/ui-lib": "^0.37.2",
    "@supabase/supabase-js": "^2.50.2",
    "express": "^4.18.2",
    "lucide-angular": "^0.577.0",
    "resend": "^6.37.0",
    "rxjs": "~7.8.0",
    "simple-icons": "^16.11.0",
    "swiper": "^12.1.2",
    "three": "^0.183.2",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^22.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  }
}
